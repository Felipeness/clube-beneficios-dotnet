# Copy to .env.local (ignored by git). EXPO_PUBLIC_* is inlined into the bundle: never put a secret here.
# Browser on this PC:
EXPO_PUBLIC_API_URL=http://localhost:5135
# Phone with Expo Go on the same Wi-Fi: use this PC's LAN IP (ipconfig, "IPv4 Address"), e.g.
# EXPO_PUBLIC_API_URL=http://192.168.0.10:5135
