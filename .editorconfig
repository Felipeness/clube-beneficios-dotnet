root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{csproj,props,slnx,json,yml,yaml}]
indent_size = 2

[*.{ts,tsx,js,jsx,json}]
indent_size = 2

[*.cs]
# var only where the type is visible on the right side; built-in types (int, decimal, string...)
# stay explicit because numeric precision matters in a domain that handles credits and money.
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_for_built_in_types = false:warning
csharp_style_var_elsewhere = false:suggestion
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = warning

csharp_style_namespace_declarations = file_scoped:warning
dotnet_diagnostic.IDE0161.severity = warning
